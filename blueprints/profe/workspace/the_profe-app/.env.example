# ---------------------------------------------------------------------------
# profe — cliente Expo. Copia a the_profe-app/.env.
#
# TODO lo que lleva el prefijo EXPO_PUBLIC_ acaba dentro del bundle de JS, que es
# legible por cualquiera que tenga el .apk o el .ipa. No pongas aquí ninguna clave
# de proveedor: las de Azure, Anthropic y Gemini viven SÓLO en el backend, y por
# eso el audio va teléfono → backend → proveedor.
#
# Este archivo SÍ se commitea (negación !the_profe-app/.env.example en .gitignore);
# the_profe-app/.env NUNCA.
# ---------------------------------------------------------------------------

# Paso 1: variante de build. development | preview | production
APP_VARIANT=development

# Paso 4: Supabase. La clave anónima es pública por diseño; lo que protege los
# datos es RLS, no el secreto de esta clave.
EXPO_PUBLIC_SUPABASE_URL=https://REEMPLAZA.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Paso 8: backend. En desarrollo sobre dispositivo físico, sustituye 127.0.0.1
# por la IP de tu máquina en la red local.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Paso 13: relé de audio. Mismo host y puerto que el backend.
EXPO_PUBLIC_AUDIO_WS_URL=ws://127.0.0.1:8787

# Paso 18: telemetría. Vacío desactiva el reporte; el código no debe fallar por ello.
EXPO_PUBLIC_SENTRY_DSN=

# Paso 18: perfiles de EAS. Se obtiene con `pnpm dlx eas-cli@^24.8.0 init`.
EAS_PROJECT_ID=
