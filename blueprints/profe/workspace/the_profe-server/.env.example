# ---------------------------------------------------------------------------
# profe — backend. Copia este archivo a the_profe-server/.env y rellena los valores.
# Este archivo SÍ se commitea (ver la negación !the_profe-server/.env.example en
# .gitignore); the_profe-server/.env NUNCA.
#
# La columna "Requerida desde el paso" de §10 es un contrato: `src/env.ts` trata
# una variable como obligatoria sólo a partir del paso que la consume, y como
# opcional antes. Por eso un paso nuevo no rompe el gate de un paso anterior.
# ---------------------------------------------------------------------------

# --- Paso 5: servidor HTTP ---
NODE_ENV=development
PORT=8787

# --- Paso 3 y 5: base de datos ---
# Base LOCAL de pruebas que levanta docker-compose.yml. Valor literal, funciona
# tal cual: es el mismo puerto y la misma base que declara el compose.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/profe_test

# Supabase. El pooler para la aplicación; la URL directa SÓLO para migraciones.
# Panel de Supabase → Project Settings → Database → Connection string.
SUPABASE_URL=https://REEMPLAZA.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_DIRECT_URL=

# Bucket de Supabase Storage donde vive el audio.
SUPABASE_STORAGE_BUCKET=audio

# --- Paso 6: pasarela de modelo ---
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Paso 7: cuotas ---
# 20 min/día × 30 días = 36000 s por perfil y periodo.
VOICE_QUOTA_SECONDS_PER_PERIOD=36000
# Techo de gasto por perfil y periodo, en micro-euros. 12,50 € × 4 perfiles = 50 €.
COST_MICROS_CAP_PER_PERIOD=12500000
# Vida de una reserva antes de que el barrendero la libere.
VOICE_SESSION_TTL_SECONDS=5400

# --- Paso 12 y 14: Azure Speech ---
# portal.azure.com → recurso Speech (SKU S1) → Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# VERIFICAR ANTES DE INSTALAR: el nombre de voz se valida contra el endpoint
# voices/list de la región en el gate del paso 12. No se da por bueno.
AZURE_TTS_VOICE=pt-PT-DuarteNeural

# --- Paso 15: Gemini Live ---
# aistudio.google.com → API keys
GEMINI_API_KEY=
# VERIFICAR ANTES DE INSTALAR: el ID de modelo semi-cascada que admite
# speech_config.language_code quedó sin verificar. El paso 15 lo resuelve contra
# la documentación en vivo antes de escribirlo aquí.
GEMINI_LIVE_MODEL=

# --- Paso 18: telemetría ---
# Vacío desactiva el reporte de errores; el código no debe fallar por ello.
SENTRY_DSN=
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Correo transaccional — obligatorias desde el PASO 12.
# El SMTP de Supabase Auth apunta a Resend para que confirmación y
# restablecimiento salgan de MAIL_DOMAIN y no del remitente de Supabase, que
# está limitado a unos pocos por hora y sirve para probar, no para un producto.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=
# El dominio sobre el que se publican SPF, DKIM y DMARC. `pnpm run check:mail-dns`
# los resuelve y sale distinto de 0 nombrando el que falte.
MAIL_DOMAIN=

# ---------------------------------------------------------------------------
# Stripe — obligatorias desde el PASO 13.
# STRIPE_WEBHOOK_SECRET **no es** la clave de API: es un secreto por endpoint,
# empieza por `whsec_`, y Stripe lo muestra al crear el webhook. Confundirlos da
# un 400 permanente en la verificación de firma que se lee como «no me llega».
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Obligatorias desde el PASO 14.
STRIPE_PORTAL_RETURN_URL=
WEB_BASE_URL=

# ---------------------------------------------------------------------------
# Límite de tasa — obligatorias desde el PASO 22.
# Contadores EN MEMORIA del proceso: válido para UNA instancia. Con dos
# réplicas el límite real se duplica. Declarado en docs/limites.md y §20.3 R10.
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_PER_USER=30
RATE_LIMIT_MAX_SIGNUPS_PER_IP=3
