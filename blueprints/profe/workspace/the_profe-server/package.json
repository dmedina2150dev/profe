{
  "name": "profe-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de profe: pasarela de modelo, cuotas de voz y relés de audio (Azure STT/TTS y Gemini Live).",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check:env": "node scripts/check-env.ts",
    "db:local:up": "docker compose -f ../docker-compose.yml up -d --wait",
    "db:local:down": "docker compose -f ../docker-compose.yml down -v",
    "db:local:apply": "bash scripts/apply-migrations.sh",
    "db:local:assert": "docker compose -f ../docker-compose.yml exec -T db psql -v ON_ERROR_STOP=1 -U postgres -d profe_test -f /repo/the_profe-server/tests/sql/assert_schema.sql",
    "db:local:reset": "pnpm run db:local:up && pnpm run db:local:apply",
    "db:migration:new": "pnpm dlx supabase@2.118.0 migration new",
    "db:push": "pnpm dlx supabase@2.118.0 db push",
    "check:mail-dns": "node scripts/check-mail-dns.ts",
    "db:restore:drill": "bash scripts/restore-drill.sh",
    "check:azure-voice": "node scripts/check-azure-voice.ts",
    "sweep": "node dist/budget/sweeper.js",
    "eval": "node dist/eval/runner.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "@hono/node-server": "^2.1.3",
    "@supabase/supabase-js": "^2.117.2",
    "hono": "^4.13.11",
    "microsoft-cognitiveservices-speech-sdk": "^1.52.0",
    "pg": "^8.16.3",
    "resend": "^6.32.0",
    "stripe": "22.6.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "supabase": "2.118.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
